<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 控制台日志格式：时间 | 线程 | 级别 | traceId=xxx spanId=xxx（OpenTelemetry 注入后可在 MDC 中输出）| logger | 消息 -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [trace_id=%X{trace_id}] [span_id=%X{span_id}] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 根日志级别为 INFO -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- demo 包开启 DEBUG，确保 DemoController 中的 debug 日志能输出 -->
    <logger name="com.example.demo" level="DEBUG"/>
</configuration>
